@model RaceDay.Mvc.ViewModels.CreateEnrolmentViewModel

<h2>Participant Enrolment</h2>

<div class="card">
    <div class="card-body">

        <p>
            Event ID:
            <strong>@Model.EventId</strong>
        </p>

        <form method="post">

            <input asp-for="EventId" type="hidden" />

            <button class="btn btn-success">
                Confirm Enrolment
            </button>

        </form>

    </div>
</div>