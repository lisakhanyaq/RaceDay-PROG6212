@model RaceDay.Mvc.ViewModels.CreateEventViewModel

<h2>Create Event</h2>

<form method="post">

    <div class="mb-3">
        <label>Name</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Description</label>
        <input asp-for="Description" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Date</label>
        <input asp-for="EventDate"
               type="datetime-local"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Location</label>
        <input asp-for="Location"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Distance</label>
        <input asp-for="DistanceKm"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Event Type</label>
        <input asp-for="EventType"
               class="form-control" />
    </div>

    <button class="btn btn-success">
        Save Event
    </button>

</form>