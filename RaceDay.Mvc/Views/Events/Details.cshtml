namespace RaceDay.Mvc.Views.Events
{
    public class Details
@model RaceDay.Mvc.ViewModels.EventViewModel

<h2>@Model.Name</h2>

<div class="card">

    <div class="card-body">

        <p>
            <strong>Description:</strong>
            @Model.Description
        </p>

        <p>
            <strong>Date:</strong>
            @Model.EventDate.ToShortDateString()
        </p>

        <p>
            <strong>Location:</strong>
            @Model.Location
        </p>

        <p>
            <strong>Distance:</strong>
            @Model.DistanceKm km
        </p>

        <p>
            <strong>Type:</strong>
            @Model.EventType
        </p>
        <hr />

        <a class="btn btn-success"
           asp-controller="Enrolments"
           asp-action="Create"
           asp-route-id="@Model.EventId">
            Enter Event
        </a>
        <hr />

        <a class="btn btn-success"
           asp-controller="Enrolments"
           asp-action="Create"
           asp-route-id="@Model.EventId">
            Enter Event
        </a>

    </div>

</div>
    {
    }
}
